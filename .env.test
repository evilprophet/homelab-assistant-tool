### ---------------------------------------------------------------------------
### Test Environment
### ---------------------------------------------------------------------------

APP_SECRET=test-app-secret-please-change
DEFAULT_URI=http://localhost

### ---------------------------------------------------------------------------
### Authentication
### ---------------------------------------------------------------------------

HAT_AUTH_MODE=simple
HAT_JWT_SECRET=test-jwt-secret-please-change
HAT_JWT_TTL_SECONDS=43200
HAT_JWT_COOKIE_NAME=hat_auth_token
HAT_OIDC_PROVIDER_NAME="Test OIDC"

### ---------------------------------------------------------------------------
### OIDC
### ---------------------------------------------------------------------------

OIDC_ISSUER=http://localhost/oidc/
OIDC_CLIENT_ID=test-client-id
OIDC_CLIENT_SECRET=test-client-secret
OIDC_REDIRECT_URI=http://localhost/auth/callback
