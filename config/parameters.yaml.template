parameters:
  configuration:
    cron: true # Enable or disable cron jobs. Command hat:cron:execute has to be manually added to crontab.
    ups_mode: true|false # When enabled cron schedule won't be executed if any UPS is on battery and devices will be shut down when battery is low.
    ssh_key_path: # Path to SSH key
    timezone: # Timezone for the server

  devices:
    # device_name: Unique of the device
    # platform: linux|debian|ubuntu|proxmox_ve|proxmox_bs
    # ip: IP address of the device
    # mac: MAC address of the device
    # ups_identifier: Identifier of the UPS to which the device is connected
    # username: SSH username for the device
    - { name: "device_name", platform: "linux", ip: "192.168.1.1", mac: "00:00:00:00:00:00", ups_identifier: "ups", username: "user" }

  ups:
    # name: Unique name of the UPS
    # identifier: Name of UPS defined in NUT
    # host: IP address of the UPS
    - { name: "ups_name", identifier: "ups", host: "localhost" }

  schedules:
    # name: Name of the schedule
    # schedule: Cron schedule
    # command: Command to execute
    # devices: List of devices to execute the command on
    - { name: "Start Devices", schedule: "0 0 * * *", command: "start", devices: [ "device1" ] }
    - { name: "Stop Devices", schedule: "0 3 * * *", command: "stop", devices: [ "device1" ] }
