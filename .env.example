### ---------------------------------------------------------------------------
### App Runtime
### ---------------------------------------------------------------------------

# Public base URL used by Symfony URL generation.
# Example: http://localhost, https://hat.example.local
DEFAULT_URI=https://hat.example.local

# Symfony environment:
# - prod: production defaults, less verbose errors
# - dev: development defaults, verbose errors
APP_ENV=prod

# Symfony debug mode:
# - 0: disabled
# - 1: enabled
APP_DEBUG=0

# Application secret used by Symfony internals.
# Generate a long random value for production.
# Generate example value:
# - openssl rand -hex 64
# - pwgen -s 128 1  (if installed)
APP_SECRET={app_secret}

### ---------------------------------------------------------------------------
### Authentication
### ---------------------------------------------------------------------------

# Authentication mode:
# - simple: local username/password login
# - oidc: OIDC login (Authentik or compatible provider)
HAT_AUTH_MODE=simple

# JWT signing secret (used for auth cookie token).
# Must be strong and unique in production.
# Generate example value:
# - openssl rand -hex 64
# - pwgen -s 128 1  (if installed)
# Use a different value than APP_SECRET.
HAT_JWT_SECRET={hat_jwt_secret}

# JWT token lifetime in seconds.
# Example: 43200 = 12 hours.
HAT_JWT_TTL_SECONDS=43200

# Cookie name used to store JWT auth token.
HAT_JWT_COOKIE_NAME=hat_auth_token

# Label displayed on login button in OIDC mode.
HAT_OIDC_PROVIDER_NAME={hat_oidc_provider_name}

### ---------------------------------------------------------------------------
### OIDC (required when HAT_AUTH_MODE=oidc)
### ---------------------------------------------------------------------------

# OIDC issuer base URL.
# Example for Authentik: https://auth.example.local/application/o/hat/
OIDC_ISSUER={oidc_issuer}

# OIDC client identifier configured in your provider.
OIDC_CLIENT_ID={oidc_client_id}

# OIDC client secret configured in your provider.
OIDC_CLIENT_SECRET={oidc_client_secret}

# Redirect URI registered in provider and served by this app.
OIDC_REDIRECT_URI=https://hat.example.local/auth/callback

### ---------------------------------------------------------------------------
### Docker Compose (optional, consumed by compose)
### ---------------------------------------------------------------------------

# Build-time toggle for Xdebug in Docker image:
# - 0: build image without Xdebug
# - 1: install and enable Xdebug extension
HAT_WITH_XDEBUG=0

# Runtime Xdebug mode (used only when Xdebug is installed).
XDEBUG_MODE=off

# Runtime Xdebug client config (used only when Xdebug is installed).
XDEBUG_CONFIG='client_host=host.docker.internal client_port=9003 idekey=xdebug'
