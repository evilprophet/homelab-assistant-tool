{% extends 'base.html.twig' %}

{% block body %}
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 mb-8">
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm p-6 border border-slate-200 dark:border-slate-700">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Total Devices</p>
                    <p class="text-2xl font-bold text-slate-800 dark:text-white mt-1">{{ stats.devices }}</p>
                </div>
                <div class="h-10 w-10 bg-blue-50 dark:bg-blue-900/30 rounded-lg flex items-center justify-center text-blue-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm p-6 border border-slate-200 dark:border-slate-700">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-slate-500 dark:text-slate-400">UPS Units</p>
                    <p class="text-2xl font-bold text-slate-800 dark:text-white mt-1">{{ stats.ups }}</p>
                </div>
                <div class="h-10 w-10 bg-green-50 dark:bg-green-900/30 rounded-lg flex items-center justify-center text-green-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm p-6 border border-slate-200 dark:border-slate-700">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Active Schedules</p>
                    <p class="text-2xl font-bold text-slate-800 dark:text-white mt-1">{{ stats.active_schedules }}</p>
                </div>
                <div class="h-10 w-10 bg-violet-50 dark:bg-violet-900/30 rounded-lg flex items-center justify-center text-violet-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6 mb-8">
        <section class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 flex flex-col">
            <div class="px-6 py-4 border-b border-slate-100 dark:border-slate-700 flex justify-between items-center">
                <h3 class="font-bold text-slate-800 dark:text-white">Devices</h3>
                <a href="{{ path('hat_devices_index') }}" class="text-xs text-blue-600 hover:text-blue-700 font-medium">View All</a>
            </div>
            <div class="flex-1 overflow-y-auto max-h-64">
                <ul class="divide-y divide-slate-100 dark:divide-slate-700">
                    {% for device in devices %}
                        {% set status = status_by_name[device.name]|default('unknown') %}
                        <li class="px-6 py-3 hover:bg-slate-50 dark:hover:bg-slate-700/50 flex items-center justify-between transition-colors">
                            <div class="flex items-center gap-3">
                                <span data-runtime-device-status="{{ device.name }}" data-status-online="bg-green-500" data-status-offline="bg-red-500" class="w-2 h-2 rounded-full {{ status == 'online' ? 'bg-green-500' : (status == 'offline' ? 'bg-red-500' : 'bg-slate-400') }}"></span>
                                <div>
                                    <div class="text-sm font-medium text-slate-900 dark:text-white">{{ device.name }}</div>
                                    <div class="text-xs text-slate-500 dark:text-slate-400">{{ device.ip }}</div>
                                </div>
                            </div>
                            <span class="text-xs text-slate-400 dark:text-slate-500">{{ device.platform }}</span>
                        </li>
                    {% else %}
                        <li class="px-6 py-4 text-sm text-slate-500 dark:text-slate-400">No devices.</li>
                    {% endfor %}
                </ul>
            </div>
        </section>

        <section class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 flex flex-col">
            <div class="px-6 py-4 border-b border-slate-100 dark:border-slate-700 flex justify-between items-center">
                <h3 class="font-bold text-slate-800 dark:text-white">UPS Status</h3>
                <a href="{{ path('hat_ups_index') }}" class="text-xs text-blue-600 hover:text-blue-700 font-medium">View All</a>
            </div>
            <div class="flex-1 overflow-y-auto max-h-64">
                <ul class="divide-y divide-slate-100 dark:divide-slate-700">
                    {% for ups in ups_collection %}
                        {% set ups_status = ups.status|default('Unknown') %}
                        {% set ups_status_class = ups_status == 'On Battery'
                            ? 'bg-amber-100 dark:bg-amber-900/30 text-amber-800 dark:text-amber-400'
                            : (ups_status == 'Online'
                                ? 'bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-400'
                                : 'bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300') %}
                        <li class="px-6 py-3 hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors">
                            <div class="flex items-start justify-between gap-3">
                                <div>
                                    <div class="text-sm font-medium text-slate-900 dark:text-white">{{ ups.name }}</div>
                                    <div data-runtime-ups-details="{{ ups.identifier }}" class="text-xs text-slate-500 dark:text-slate-400">
                                        Battery data unavailable
                                    </div>
                                </div>
                                <span data-runtime-ups-badge="{{ ups.identifier }}" data-tone-success="bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-400" data-tone-warning="bg-amber-100 dark:bg-amber-900/30 text-amber-800 dark:text-amber-400" data-tone-neutral="bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300" class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full {{ ups_status_class }}">
                                    {{ ups_status }}
                                </span>
                            </div>
                        </li>
                    {% else %}
                        <li class="px-6 py-4 text-sm text-slate-500 dark:text-slate-400">No UPS units.</li>
                    {% endfor %}
                </ul>
            </div>
        </section>

        <section class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 flex flex-col">
            <div class="px-6 py-4 border-b border-slate-100 dark:border-slate-700 flex justify-between items-center">
                <h3 class="font-bold text-slate-800 dark:text-white">Next Schedules</h3>
                <a href="{{ path('hat_schedules_index') }}" class="text-xs text-blue-600 hover:text-blue-700 font-medium">View All</a>
            </div>
            <div class="flex-1 overflow-y-auto max-h-64">
                <ul class="divide-y divide-slate-100 dark:divide-slate-700">
                    {% for schedule in schedules %}
                        {% set next_run = next_run_by_schedule_id[schedule.id]|default(null) %}
                        <li class="px-6 py-3 hover:bg-slate-50 dark:hover:bg-slate-700/50 flex items-center justify-between transition-colors">
                            <div>
                                <div class="text-sm font-medium text-slate-900 dark:text-white">{{ schedule.name }}</div>
                                <div class="text-xs text-slate-500 dark:text-slate-400">
                                    {{ next_run is null ? 'No upcoming run' : next_run|date('Y-m-d H:i', timezone_name) }}
                                </div>
                            </div>
                            <span class="text-xs font-mono bg-slate-100 dark:bg-slate-700 px-2 py-0.5 rounded text-slate-600 dark:text-slate-300">
                                {{ schedule.command|upper }}
                            </span>
                        </li>
                    {% else %}
                        <li class="px-6 py-4 text-sm text-slate-500 dark:text-slate-400">No schedules.</li>
                    {% endfor %}
                </ul>
            </div>
        </section>
    </div>

    <section>
        <h3 class="text-lg font-bold text-slate-800 dark:text-white mb-4">Recent Activity</h3>
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
            <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-700">
                <thead class="bg-slate-50 dark:bg-slate-700/50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider">Timestamp</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider">Level</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider">Source / Action</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider">Message</th>
                    </tr>
                </thead>
                <tbody class="bg-white dark:bg-slate-800 divide-y divide-slate-200 dark:divide-slate-700">
                    {% for log in recent_logs %}
                        <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors">
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500 dark:text-slate-400">
                                {{ log.createdAt|date('Y-m-d H:i:s', timezone_name) }}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                {% set levelClass = log.level == 'error' ? 'bg-red-100 dark:bg-red-900/30 text-red-800 dark:text-red-400' : (log.level == 'warning' ? 'bg-amber-100 dark:bg-amber-900/30 text-amber-800 dark:text-amber-400' : 'bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-400') %}
                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full {{ levelClass }}">
                                    {{ log.level|upper }}
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm font-medium text-slate-900 dark:text-white">{{ log.source }}</div>
                                <div class="text-xs text-slate-500 dark:text-slate-400">{{ log.action }}</div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-sm text-slate-900 dark:text-white truncate">{{ log.message }}</div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="px-6 py-4 text-sm text-slate-500 dark:text-slate-400">No logs.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}

{% block body_scripts %}
    {% include 'ui/_runtime_status_script.html.twig' only %}
{% endblock %}
