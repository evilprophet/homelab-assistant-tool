{% extends 'base.html.twig' %}

{% block page_actions %}
    <a href="{{ path('hat_ups_new') }}" class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        New UPS
    </a>
{% endblock %}

{% block body %}
    <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
        {% if ups_collection is empty %}
            <div class="p-6 text-sm text-slate-500 dark:text-slate-400">No UPS entries found.</div>
        {% else %}
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-700">
                    <thead class="bg-slate-50 dark:bg-slate-700/50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider">Name / Identifier</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider">Model Name</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider">Serial Number</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider">Status</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider">Power</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider">Battery</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider">Linked Device</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider">Actions</th>
                    </tr>
                    </thead>
                    <tbody class="bg-white dark:bg-slate-800 divide-y divide-slate-200 dark:divide-slate-700">
                    {% for ups in ups_collection %}
                        <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors align-top">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center">
                                    <div class="h-10 w-10 flex-shrink-0 bg-amber-100 dark:bg-amber-900/30 rounded-full flex items-center justify-center text-amber-700 dark:text-amber-300">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                                        </svg>
                                    </div>
                                    <div class="ml-4">
                                        <div class="text-sm font-medium text-slate-900 dark:text-white">{{ ups.name }}</div>
                                        <div class="text-xs text-slate-500 dark:text-slate-400">{{ ups.identifier }}</div>
                                        <div class="text-xs text-slate-500 dark:text-slate-400">ID: {{ ups.id }}</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-900 dark:text-white">{{ ups.model_name }}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-900 dark:text-white">{{ ups.serial_number }}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm">
                                {% set ups_status = ups.status|default('Unknown') %}
                                {% if ups_status == 'On Battery' %}
                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-amber-100 dark:bg-amber-900/30 text-amber-800 dark:text-amber-400">
                                        On Battery
                                    </span>
                                {% elseif ups_status == 'Unknown' %}
                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300">
                                        Unknown
                                    </span>
                                {% else %}
                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-400">
                                        {{ ups_status }}
                                    </span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4">
                                {% set power_lines = ups.power is defined and ups.power != '-' ? ups.power|split("\n") : [] %}
                                <div class="space-y-1 min-w-[100px]">
                                    {% for power_line in power_lines %}
                                        <div class="px-2 py-1 rounded bg-slate-100 dark:bg-slate-700 text-xs font-mono text-slate-800 dark:text-slate-200">
                                            {{ power_line }}
                                        </div>
                                    {% else %}
                                        <span class="text-sm text-slate-500 dark:text-slate-400">-</span>
                                    {% endfor %}
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                {% set battery_lines = ups.battery is defined and ups.battery != '-' ? ups.battery|split("\n") : [] %}
                                <div class="space-y-1 min-w-[180px]">
                                    {% for battery_line in battery_lines %}
                                        <div class="px-2 py-1 rounded bg-slate-100 dark:bg-slate-700 text-xs text-slate-800 dark:text-slate-200">
                                            {{ battery_line }}
                                        </div>
                                    {% else %}
                                        <span class="text-sm text-slate-500 dark:text-slate-400">-</span>
                                    {% endfor %}
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                {% set linked_devices = ups.linked_device is defined and ups.linked_device != '-' ? ups.linked_device|split(', ') : [] %}
                                {% set linked_device_names = [] %}
                                {% for linked_device in linked_devices %}
                                    {% set device_parts = linked_device|split(':', 2) %}
                                    {% set device_name = device_parts|length > 1 ? device_parts[1] : linked_device %}
                                    {% set linked_device_names = linked_device_names|merge([device_name]) %}
                                {% endfor %}
                                {% set linked_device_names = linked_device_names|sort %}
                                <div class="flex flex-wrap gap-1 max-w-xs">
                                    {% for device_name in linked_device_names %}
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-100 dark:bg-slate-700 text-slate-800 dark:text-slate-200">
                                            <span data-linked-device-status="{{ device_name }}" class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                                            <span class="ml-1.5">{{ device_name }}</span>
                                        </span>
                                    {% else %}
                                        <span class="text-sm text-slate-500 dark:text-slate-400">-</span>
                                    {% endfor %}
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                <div class="flex items-center gap-3">
                                    <a href="{{ path('hat_ups_edit', { id: ups.id }) }}" class="text-slate-400 hover:text-blue-600 transition-colors" title="Edit" aria-label="Edit {{ ups.name }}">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                        </svg>
                                    </a>
                                    <a href="{{ path('hat_ups_remove_confirm', { id: ups.id }) }}" class="text-slate-400 hover:text-red-500 transition-colors" title="Delete" aria-label="Delete {{ ups.name }}">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                        </svg>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}

        {% include 'ui/_pagination.html.twig' with {
            route_name: 'hat_ups_index',
            page: page,
            total_pages: total_pages,
            total: total,
            query: app.request.query.all
        } only %}
    </div>
{% endblock %}

{% block body_scripts %}
    <script>
        (() => {
            const linkedDeviceDots = Array.from(document.querySelectorAll('[data-linked-device-status]'));
            if (linkedDeviceDots.length === 0) {
                return;
            }

            const deviceNames = Array.from(new Set(
                linkedDeviceDots
                    .map((node) => node.dataset.linkedDeviceStatus || '')
                    .filter((name) => name !== '')
            ));
            if (deviceNames.length === 0) {
                return;
            }

            const params = new URLSearchParams();
            deviceNames.forEach((deviceName) => {
                params.append('device_names[]', deviceName);
            });

            const linkedDotClassByStatus = {
                online: 'bg-green-400',
                offline: 'bg-red-400',
                unknown: 'bg-slate-400',
            };

            fetch('{{ path('hat_runtime_statuses') }}?' + params.toString(), {
                headers: { 'Accept': 'application/json' },
            })
                .then((response) => response.ok ? response.json() : Promise.reject())
                .then((payload) => {
                    const deviceStatusByName = payload.device_status_by_name || {};

                    linkedDeviceDots.forEach((dot) => {
                        const deviceName = dot.dataset.linkedDeviceStatus || '';
                        if (deviceName === '') {
                            return;
                        }

                        const status = typeof deviceStatusByName[deviceName] === 'string'
                            ? deviceStatusByName[deviceName]
                            : 'unknown';

                        dot.classList.remove('bg-green-400', 'bg-red-400', 'bg-slate-400');
                        dot.classList.add(linkedDotClassByStatus[status] || linkedDotClassByStatus.unknown);
                    });
                })
                .catch(() => {
                });
        })();
    </script>
{% endblock %}
