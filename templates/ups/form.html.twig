{% extends 'base.html.twig' %}

{% block page_actions %}
    <a href="{{ path('hat_ups_index') }}" class="inline-flex items-center gap-2 px-4 py-2 bg-white dark:bg-slate-700 border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-200 text-sm font-medium rounded-lg transition-colors hover:bg-slate-50 dark:hover:bg-slate-600">
        Back
    </a>
{% endblock %}

{% block body %}
    {% include 'ui/_form_errors.html.twig' with { errors: errors } only %}

    <div class="max-w-3xl mx-auto">
        <form method="post" class="space-y-6">
            <input
                type="hidden"
                name="_token"
                value="{{ csrf_token(mode == 'edit' and ups is defined ? 'ups.form.edit.' ~ ups.id : 'ups.form.create') }}"
            >
            <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-6 space-y-6">
                <h3 class="text-lg font-medium leading-6 text-slate-900 dark:text-white border-b border-slate-200 dark:border-slate-700 pb-4">UPS Information</h3>

                <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
                    <div class="sm:col-span-4">
                        <label for="ups-name" class="block text-sm font-medium text-slate-700 dark:text-slate-300">Friendly Name</label>
                        <input id="ups-name" type="text" name="name" value="{{ form_data.name }}" placeholder="e.g. Main UPS" class="mt-1 shadow-sm focus:ring-blue-500 focus:border-blue-500 block w-full sm:text-sm border-slate-300 dark:border-slate-600 rounded-lg p-2.5 border bg-white dark:bg-slate-700 dark:text-white">
                        {% include 'ui/_field_errors.html.twig' with { errors: errors, field_name: 'name' } only %}
                    </div>

                    <div class="sm:col-span-3">
                        <label for="ups-identifier" class="block text-sm font-medium text-slate-700 dark:text-slate-300">NUT Identifier</label>
                        <input id="ups-identifier" type="text" name="identifier" value="{{ form_data.identifier }}" placeholder="ups-core" class="mt-1 shadow-sm focus:ring-blue-500 focus:border-blue-500 block w-full sm:text-sm border-slate-300 dark:border-slate-600 rounded-lg p-2.5 border bg-white dark:bg-slate-700 dark:text-white">
                        {% include 'ui/_field_errors.html.twig' with { errors: errors, field_name: 'identifier' } only %}
                    </div>

                    <div class="sm:col-span-3">
                        <label for="ups-host" class="block text-sm font-medium text-slate-700 dark:text-slate-300">Host</label>
                        <input id="ups-host" type="text" name="host" value="{{ form_data.host }}" placeholder="127.0.0.1" class="mt-1 shadow-sm focus:ring-blue-500 focus:border-blue-500 block w-full sm:text-sm border-slate-300 dark:border-slate-600 rounded-lg p-2.5 border bg-white dark:bg-slate-700 dark:text-white">
                        {% include 'ui/_field_errors.html.twig' with { errors: errors, field_name: 'host' } only %}
                    </div>

                    <div class="sm:col-span-3">
                        <label for="ups-safe-threshold" class="block text-sm font-medium text-slate-700 dark:text-slate-300">Safe Runtime Threshold (Minutes)</label>
                        <input id="ups-safe-threshold" type="number" min="0" name="safe_threshold_minutes" value="{{ form_data.safe_threshold_minutes }}" placeholder="10" class="mt-1 shadow-sm focus:ring-blue-500 focus:border-blue-500 block w-full sm:text-sm border-slate-300 dark:border-slate-600 rounded-lg p-2.5 border bg-white dark:bg-slate-700 dark:text-white">
                        {% include 'ui/_field_errors.html.twig' with { errors: errors, field_name: 'safe_threshold_minutes' } only %}
                    </div>
                </div>
            </div>

            <div class="flex items-center justify-end gap-3">
                <a href="{{ path('hat_ups_index') }}" class="bg-white dark:bg-slate-700 py-2 px-4 border border-slate-300 dark:border-slate-600 rounded-lg shadow-sm text-sm font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-600">Cancel</a>
                <button type="submit" class="bg-blue-600 py-2 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white hover:bg-blue-700">
                    {{ mode == 'edit' ? 'Save UPS' : 'Create UPS' }}
                </button>
            </div>
        </form>
    </div>
{% endblock %}
