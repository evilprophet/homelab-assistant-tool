{% extends 'base.html.twig' %}

{% block body %}
    <div class="max-w-2xl bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-6">
        <h3 class="text-lg font-semibold text-slate-900 dark:text-white">Remove UPS "{{ ups.identifier }}"</h3>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">This action cannot be undone.</p>

        {% if linked_device_names is not empty %}
            <div class="mt-4 border border-amber-200 bg-amber-50 dark:bg-amber-900/20 dark:border-amber-800 rounded-lg p-4 text-sm text-amber-800 dark:text-amber-200">
                <p class="font-semibold">Devices that will be detached:</p>
                <ul class="list-disc pl-5 mt-1">
                    {% for device_name in linked_device_names %}
                        <li>{{ device_name }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        <div class="mt-6 flex gap-3 justify-end">
            <a href="{{ path('hat_ups_index') }}" class="bg-white dark:bg-slate-700 py-2 px-4 border border-slate-300 dark:border-slate-600 rounded-lg shadow-sm text-sm font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-600">Cancel</a>
            <form method="post" action="{{ path('hat_ups_remove', { id: ups.id }) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('ups.remove.' ~ ups.id) }}">
                <button type="submit" class="bg-red-600 py-2 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white hover:bg-red-700">Confirm Remove</button>
            </form>
        </div>
    </div>
{% endblock %}
