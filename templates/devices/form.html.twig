{% extends 'base.html.twig' %}

{% block page_actions %}
    <a href="{{ path('hat_devices_index') }}" class="inline-flex items-center gap-2 px-4 py-2 bg-white dark:bg-slate-700 border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-200 text-sm font-medium rounded-lg transition-colors hover:bg-slate-50 dark:hover:bg-slate-600">
        Back
    </a>
{% endblock %}

{% block body %}
    {% include 'ui/_form_errors.html.twig' with { errors: errors } only %}

    <div class="max-w-3xl mx-auto">
        <form method="post" class="space-y-6">
            <input
                type="hidden"
                name="_token"
                value="{{ csrf_token(mode == 'edit' and device is defined ? 'device.form.edit.' ~ device.id : 'device.form.create') }}"
            >
            <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-6 space-y-6">
                <h3 class="text-lg font-medium leading-6 text-slate-900 dark:text-white border-b border-slate-200 dark:border-slate-700 pb-4">Device Information</h3>

                <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
                    <div class="sm:col-span-4">
                        <label for="device-name" class="block text-sm font-medium text-slate-700 dark:text-slate-300">Device Name</label>
                        <input id="device-name" type="text" name="name" value="{{ form_data.name }}" placeholder="e.g. Main Server" class="mt-1 shadow-sm focus:ring-blue-500 focus:border-blue-500 block w-full sm:text-sm border-slate-300 dark:border-slate-600 rounded-lg p-2.5 border bg-white dark:bg-slate-700 dark:text-white">
                        {% include 'ui/_field_errors.html.twig' with { errors: errors, field_name: 'name' } only %}
                    </div>

                    <div class="sm:col-span-2">
                        <label for="device-platform" class="block text-sm font-medium text-slate-700 dark:text-slate-300">Platform</label>
                        <select id="device-platform" name="platform" class="mt-1 shadow-sm focus:ring-blue-500 focus:border-blue-500 block w-full sm:text-sm border-slate-300 dark:border-slate-600 rounded-lg p-2.5 border bg-white dark:bg-slate-700 dark:text-white">
                            {% for platform in platforms %}
                                <option value="{{ platform }}" {{ platform == form_data.platform ? 'selected' : '' }}>{{ platform_labels[platform]|default(platform) }}</option>
                            {% endfor %}
                        </select>
                        <div class="mt-2 flex flex-wrap gap-1" data-platform-actions></div>
                        {% include 'ui/_field_errors.html.twig' with { errors: errors, field_name: 'platform' } only %}
                    </div>

                    <div class="sm:col-span-4">
                        <label for="device-ip" class="block text-sm font-medium text-slate-700 dark:text-slate-300">IP Address</label>
                        <input id="device-ip" type="text" name="ip" value="{{ form_data.ip }}" placeholder="192.168.1.10" class="mt-1 shadow-sm focus:ring-blue-500 focus:border-blue-500 block w-full sm:text-sm border-slate-300 dark:border-slate-600 rounded-lg p-2.5 border bg-white dark:bg-slate-700 dark:text-white">
                        {% include 'ui/_field_errors.html.twig' with { errors: errors, field_name: 'ip' } only %}
                    </div>

                    <div class="sm:col-span-4">
                        <label for="device-mac" class="block text-sm font-medium text-slate-700 dark:text-slate-300">MAC Address</label>
                        <input id="device-mac" type="text" name="mac" value="{{ form_data.mac }}" placeholder="00:11:22:33:44:55" class="mt-1 shadow-sm focus:ring-blue-500 focus:border-blue-500 block w-full sm:text-sm border-slate-300 dark:border-slate-600 rounded-lg p-2.5 border bg-white dark:bg-slate-700 dark:text-white">
                        {% include 'ui/_field_errors.html.twig' with { errors: errors, field_name: 'mac' } only %}
                    </div>

                    <div class="sm:col-span-4">
                        <label for="device-username" class="block text-sm font-medium text-slate-700 dark:text-slate-300">SSH Username</label>
                        <input id="device-username" type="text" name="username" value="{{ form_data.username }}" placeholder="root" class="mt-1 shadow-sm focus:ring-blue-500 focus:border-blue-500 block w-full sm:text-sm border-slate-300 dark:border-slate-600 rounded-lg p-2.5 border bg-white dark:bg-slate-700 dark:text-white">
                        {% include 'ui/_field_errors.html.twig' with { errors: errors, field_name: 'username' } only %}
                    </div>
                </div>
            </div>

            <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-6 space-y-6">
                <h3 class="text-lg font-medium leading-6 text-slate-900 dark:text-white border-b border-slate-200 dark:border-slate-700 pb-4">Power Management</h3>

                <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
                    <div class="sm:col-span-3">
                        <label for="device-ups-id" class="block text-sm font-medium text-slate-700 dark:text-slate-300">Linked UPS Unit</label>
                        <select id="device-ups-id" name="ups_id" class="mt-1 shadow-sm focus:ring-blue-500 focus:border-blue-500 block w-full sm:text-sm border-slate-300 dark:border-slate-600 rounded-lg p-2.5 border bg-white dark:bg-slate-700 dark:text-white">
                            <option value="">None</option>
                            {% for ups in ups_collection %}
                                <option value="{{ ups.id }}" {{ form_data.ups_id == (ups.id ~ '') ? 'selected' : '' }}>{{ ups.name }} ({{ ups.identifier }})</option>
                            {% endfor %}
                        </select>
                        {% include 'ui/_field_errors.html.twig' with { errors: errors, field_name: 'ups_id' } only %}
                    </div>

                    <div class="sm:col-span-3">
                        <label for="device-threshold" class="block text-sm font-medium text-slate-700 dark:text-slate-300">Runtime Threshold (Minutes)</label>
                        <input id="device-threshold" type="number" min="0" name="threshold_minutes" value="{{ form_data.threshold_minutes }}" placeholder="5" class="mt-1 shadow-sm focus:ring-blue-500 focus:border-blue-500 block w-full sm:text-sm border-slate-300 dark:border-slate-600 rounded-lg p-2.5 border bg-white dark:bg-slate-700 dark:text-white">
                        {% include 'ui/_field_errors.html.twig' with { errors: errors, field_name: 'threshold_minutes' } only %}
                    </div>

                    <div class="sm:col-span-6">
                        <input type="hidden" name="allow_auto_stop_present" value="1">
                        <label for="device-allow-auto-stop" class="inline-flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300">
                            <input
                                id="device-allow-auto-stop"
                                type="checkbox"
                                name="allow_auto_stop"
                                value="1"
                                class="rounded border-slate-300 text-blue-600 focus:ring-blue-500"
                                {{ form_data.allow_auto_stop ? 'checked' : '' }}
                            >
                            Auto stop allowed
                        </label>
                        <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">
                            When disabled, cron will not perform automatic stop actions for this device.
                        </p>
                    </div>
                </div>
            </div>

            <div class="flex items-center justify-end gap-3">
                <a href="{{ path('hat_devices_index') }}" class="bg-white dark:bg-slate-700 py-2 px-4 border border-slate-300 dark:border-slate-600 rounded-lg shadow-sm text-sm font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-600">
                    Cancel
                </a>
                <button type="submit" class="bg-blue-600 py-2 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white hover:bg-blue-700">
                    {{ mode == 'edit' ? 'Save Device' : 'Create Device' }}
                </button>
            </div>
        </form>
    </div>
{% endblock %}

{% block body_scripts %}
    <script>
        (() => {
            const platformSelect = document.getElementById('device-platform');
            const actionsContainer = document.querySelector('[data-platform-actions]');
            const platformSupportedActions = {{ platform_supported_actions|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};
            const actionLabels = {
                start: 'Start',
                stop: 'Stop',
                ssh: 'SSH',
            };
            const actionClassByType = {
                start: 'border-green-200 text-green-700 dark:border-green-700 dark:text-green-300',
                stop: 'border-amber-200 text-amber-700 dark:border-amber-700 dark:text-amber-300',
                ssh: 'border-blue-200 text-blue-700 dark:border-blue-700 dark:text-blue-300',
            };

            if (!platformSelect || !actionsContainer) {
                return;
            }

            const renderActions = () => {
                const selectedPlatform = platformSelect.value;
                const actions = Array.isArray(platformSupportedActions[selectedPlatform])
                    ? platformSupportedActions[selectedPlatform]
                    : [];

                actionsContainer.innerHTML = '';

                if (actions.length === 0) {
                    const badge = document.createElement('span');
                    badge.className = 'inline-flex items-center px-2 py-0.5 rounded border border-slate-200 dark:border-slate-600 text-xs font-medium text-slate-600 dark:text-slate-300';
                    badge.textContent = 'No actions';
                    actionsContainer.appendChild(badge);
                    return;
                }

                actions.forEach((action) => {
                    const badge = document.createElement('span');
                    const actionClass = actionClassByType[action] || 'border-slate-200 dark:border-slate-600 text-slate-700 dark:text-slate-300';
                    badge.className = 'inline-flex items-center px-2 py-0.5 rounded border text-xs font-medium ' + actionClass;
                    badge.textContent = actionLabels[action] || action.toUpperCase();
                    actionsContainer.appendChild(badge);
                });
            };

            platformSelect.addEventListener('change', renderActions);
            renderActions();
        })();
    </script>
{% endblock %}
